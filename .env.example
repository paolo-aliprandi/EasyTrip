# Full backend startup requires MongoDB, a signing secret, and Google OAuth.
DB_URL=mongodb://127.0.0.1:27017/easytrip
TOKEN_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://localhost:12345/v1/users/auth/google/callback

# Live routes, place search, and automatic POI-based stops use this key.
GRAPHHOPPER_KEY=

# Optional: a missing weather key must not block route planning.
WEATHER_API_KEY=

# Optional permanent public origin; Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
